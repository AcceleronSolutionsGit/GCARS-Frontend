<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward /api requests to backend if not configured in vhost
  # RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]

  # Direct all non-file/directory requests to index.html for React Router SPA
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
